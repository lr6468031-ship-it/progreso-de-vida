<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="Progreso de Vida"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlannerActivity"
            android:exported="false"
            android:label="Tareas recurrentes"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:label="Estadísticas"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:label="Metas"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:label="Mi progreso"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".SkillGoalsActivity"
            android:exported="false"
            android:label="Metas y habilidades"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <receiver
            android:name=".ProgressWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/progress_widget_info" />
        </receiver>
    </application>

</manifest>
